// Copy this file to Secrets.swift and fill in your values.
// Secrets.swift is gitignored and will not be committed.

import Foundation

enum Secrets {
  // REQUIRED: Get your key at https://aistudio.google.com/apikey
  static let geminiAPIKey = "YOUR_GEMINI_API_KEY"

  // OPTIONAL: OpenClaw gateway config (for agentic tool-calling)
  // Use your Mac's Bonjour hostname (run: scutil --get LocalHostName)
  static let openClawHost = "http://YOUR_MAC_HOSTNAME.local"
  static let openClawPort = 18789
  static let openClawHookToken = "YOUR_OPENCLAW_HOOK_TOKEN"
  static let openClawGatewayToken = "YOUR_OPENCLAW_GATEWAY_TOKEN"

  // OPTIONAL: WebRTC signaling server URL (for live POV streaming)
  // Run: cd samples/CameraAccess/server && npm install && npm start
  static let webrtcSignalingURL = "ws://YOUR_MAC_IP:8080"

  // OPTIONAL: Rio cross-surface persistent memory backbone
  // FastAPI service running on the user's VPS (or any reachable host).
  // Endpoints used: GET /memory/recall, POST /memory.
  // The bearer key is generated when deploying rio-memory; keep it as a UserDefaults override
  // (Settings screen) for production rather than committing here.
  static let rioMemoryURL = "YOUR_RIO_MEMORY_URL"          // e.g. https://memory.example.com or http://10.0.0.5:8088
  static let rioMemoryAPIKey = "YOUR_RIO_MEMORY_API_KEY"   // bearer token (Authorization: Bearer <key>)
}
